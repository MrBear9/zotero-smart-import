{
  "name": "zotero-smart-import",
  "version": "1.0.1",
  "description": "Zotero plugin: reuse existing collections and merge duplicate items on import.",
  "type": "module",
  "private": true,
  "author": "MrBear9",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/MrBear9/zotero-smart-import",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBear9/zotero-smart-import.git"
  },
  "bugs": {
    "url": "https://github.com/MrBear9/zotero-smart-import/issues"
  },
  "keywords": [
    "zotero",
    "zotero-plugin",
    "ris",
    "duplicate",
    "collection"
  ],
  "config": {
    "addonName": "Zotero Smart Import",
    "addonID": "smart-import@mrbear.dev",
    "addonRef": "smartimport",
    "addonInstance": "SmartImport",
    "prefsPrefix": "extensions.zotero.smartimport"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "release": "node scripts/build.mjs --release",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "check": "node --check src/index.js",
    "clean": "node scripts/clean.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "npm run sync-version && git add addon/manifest.json"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "profile": "zotero",
    "extends": null
  }
}
